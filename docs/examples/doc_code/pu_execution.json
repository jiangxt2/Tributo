{
  "algorithm": "pu",
  "profile": "local",
  "worker_count": 2,
  "input": {
    "ingestion": {
      "source": {
        "type": "parquet",
        "path": "/shared/training-data/*.parquet"
      },
      "engine": "ray"
    },
    "features": ["account_age", "monthly_usage"],
    "label": "is_confirmed_positive"
  },
  "algorithm_config": {
    "model": {
      "input_features": 2,
      "hidden_units": [128, 64, 32]
    },
    "loss": {
      "type": "nnpu",
      "class_prior": 0.3
    },
    "optimizer": {
      "learning_rate": 0.001
    },
    "metrics": {},
    "training": {
      "epochs": 50,
      "batch_size": 1024,
      "prefetch_batches": 0,
      "seed": 42
    },
    "ray": {
      "max_failures": 0,
      "storage_path": "/shared/ray-results/pu-fraud"
    },
    "output": {
      "bundle_uri": "/shared/models/pu-fraud"
    }
  },
  "local_runtime": {
    "num_cpus": 2,
    "num_gpus": 0
  }
}
