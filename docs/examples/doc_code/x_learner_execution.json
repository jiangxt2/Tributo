{
  "algorithm": "x_learner",
  "profile": "local",
  "worker_count": 2,
  "input": {
    "ingestion": {
      "source": {
        "type": "parquet",
        "path": "/absolute/path/to/uplift-training.parquet"
      },
      "engine": "ray"
    },
    "features": ["age", "tenure", "treatment", "customer_id"],
    "label": "outcome"
  },
  "algorithm_config": {
    "data": {
      "feature_columns": ["age", "tenure"],
      "treatment_col": "treatment",
      "outcome_col": "outcome",
      "identity_col": "customer_id"
    },
    "model": {
      "outcome": {
        "objective": "binary:logistic",
        "max_depth": 6,
        "eta": 0.1
      },
      "effect": {
        "objective": "reg:squarederror",
        "max_depth": 6,
        "eta": 0.1
      },
      "propensity": {
        "objective": "binary:logistic",
        "max_depth": 6,
        "eta": 0.1
      }
    },
    "training": {
      "num_rounds": 200,
      "val_size": 0.2,
      "test_size": 0.2,
      "seed": 42,
      "response_threshold": 0.5,
      "propensity_clip": [0.001, 0.999],
      "curve_points": 100
    },
    "ray": {
      "num_workers": 2,
      "max_failures": 0
    },
    "output": {
      "bundle_uri": "/absolute/path/to/bundles/x-learner"
    }
  }
}
