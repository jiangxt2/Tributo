{
  "dist": {
    "module": "github.com/jiangxt2/Tributo/otelcol",
    "name": "tributo-otelcol",
    "description": "Tributo minimal logs Collector (upstream components)",
    "version": "0.163.2"
  },
  "receivers": [{"gomod": "go.opentelemetry.io/collector/receiver/otlpreceiver v0.163.0"}],
  "processors": [{"gomod": "go.opentelemetry.io/collector/processor/memorylimiterprocessor v0.163.0"}],
  "exporters": [{"gomod": "github.com/open-telemetry/opentelemetry-collector-contrib/exporter/dorisexporter v0.163.0"}],
  "extensions": [{"gomod": "github.com/open-telemetry/opentelemetry-collector-contrib/extension/healthcheckextension v0.163.0"}],
  "providers": [
    {"gomod": "go.opentelemetry.io/collector/confmap/provider/envprovider v1.69.0"},
    {"gomod": "go.opentelemetry.io/collector/confmap/provider/fileprovider v1.69.0"}
  ]
}
