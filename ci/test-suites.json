{
  "schema_version": 1,
  "budgets": {
    "ci_fast_suite_seconds": 720,
    "ci_scheduled_suite_seconds": 600,
    "nightly_total_seconds": 1800
  },
  "path_rules": [
    {
      "name": "ci-policy",
      "patterns": [
        ".github/workflows/**",
        "ci/**",
        "scripts/ci_test_plan.py",
        "scripts/pr-precheck.py",
        "tests/test_ci_test_plan.py",
        "tests/test_pr_precheck.py",
        "pyproject.toml",
        "uv.lock"
      ],
      "domains": ["code", "docs", "storage"]
    },
    {
      "name": "documentation",
      "patterns": [
        "README.md",
        ".readthedocs.yaml",
        "Makefile",
        "requirements-doc.in",
        "requirements-doc.lock",
        "docs/**",
        "tests/docs/**",
        "tests/integration/test_docs_reference.py",
        "scripts/verify_readme_examples.py",
        "tools/__init__.py",
        "tools/check_docs.py",
        "tools/generate_algorithm_support_matrix.py",
        "tools/generate_public_api_reference.py"
      ],
      "domains": ["docs"]
    },
    {
      "name": "storage",
      "patterns": [
        "src/tributo/_common/storage.py",
        "src/tributo/_common/storage_profiles.py",
        "src/tributo/data/_s3.py",
        "src/tributo/exporting/**",
        "src/tributo/integrations/storage/**",
        "tests/integration/test_export_s3.py",
        "tests/data/test_ds_parquet_csv.py"
      ],
      "domains": ["code", "docs", "storage"]
    },
    {
      "name": "source",
      "patterns": ["src/**"],
      "domains": ["code", "docs", "storage"]
    },
    {
      "name": "runtime-image",
      "patterns": [
        "docker/**",
        "tools/tributo-runtime-full.json",
        "tools/build_tributo_image.py"
      ],
      "domains": ["code", "storage"]
    },
    {
      "name": "tests",
      "patterns": ["tests/**", "scripts/**", "tools/**"],
      "domains": ["code", "storage"]
    }
  ],
  "suites": [
    {
      "id": "policy",
      "owner": "ci",
      "domain": "policy",
      "tier": "ci_fast",
      "workflow": "matrix",
      "always_run": true,
      "owns_tests": false,
      "entrypoint": ["python", "-m", "pytest"],
      "args": [
        "tests/test_ci_test_plan.py",
        "-o",
        "addopts=",
        "--strict-markers",
        "-q",
        "--tb=short"
      ],
      "extras": ["dev"],
      "test_paths": ["tests/test_ci_test_plan.py"],
      "trigger_domains": [],
      "trigger_paths": [],
      "requires": [],
      "budget_seconds": 180,
      "ci_allowed": true,
      "forbid_skips": true,
      "log_contract": "pytest terminal output and GitHub job summary",
      "rationale": "Always validates the manifest, planner, workflows, and fail-safe selection rules."
    },
    {
      "id": "unit",
      "owner": "core",
      "domain": "core",
      "tier": "ci_fast",
      "workflow": "unit",
      "default_test_owner": true,
      "owns_tests": true,
      "entrypoint": ["python", "-m", "pytest"],
      "args": [
        "tests/",
        "--ignore=tests/test_ci_test_plan.py",
        "-m",
        "not integration and not slow and not distributed and not minio_compat and not ray_runtime_env and not ci_safe and not s3_contract and not manual_it and not quarantine",
        "-v",
        "--tb=short",
        "--timeout=180"
      ],
      "extras": ["dev"],
      "test_paths": [],
      "trigger_domains": ["code"],
      "trigger_paths": [],
      "requires": [],
      "budget_seconds": 720,
      "ci_allowed": true,
      "forbid_skips": false,
      "log_contract": "pytest terminal output",
      "rationale": "Default owner for test modules that do not require an explicit integration tier."
    },
    {
      "id": "unit-integration-contracts",
      "owner": "ci",
      "domain": "contracts",
      "tier": "ci_fast",
      "workflow": "matrix",
      "owns_tests": true,
      "entrypoint": ["python", "-m", "pytest"],
      "args": [
        "tests/integration/test_distributed_algorithm_it_contract.py",
