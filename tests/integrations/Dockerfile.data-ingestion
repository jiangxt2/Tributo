ARG BASE_IMAGE

FROM ${BASE_IMAGE}

USER root
RUN python -m venv /opt/tributo/.venv && chown -R 1000:100 /opt/tributo

USER 1000:100

ENV PATH="/opt/tributo/.venv/bin:${PATH}" \
    PIP_DEFAULT_TIMEOUT=600 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

COPY --from=locked-requirements --chown=1000:100 /requirements.txt /opt/tributo/requirements.txt
COPY --from=locked-requirements --chown=1000:100 /runtime-version-check.py /opt/tributo/

WORKDIR /opt/tributo

# Match the full CPU image's exact Linux arm64 pip metadata exception.
# A different platform, exit code, or additional error must still fail.
RUN --mount=type=cache,target=/home/ray/.cache/pip,uid=1000,gid=100 \
    python -m pip install --require-hashes -r /opt/tributo/requirements.txt && \
    python -c "import platform, subprocess, sys; \
result = subprocess.run([sys.executable, '-m', 'pip', 'check'], capture_output=True, text=True); \
output = (result.stdout + result.stderr).strip(); \
baseline = 'nvidia-cusparselt-cu13 0.8.1 is not supported on this platform'; \
allowed = platform.system() == 'Linux' and platform.machine() == 'aarch64' and result.returncode == 1 and output == baseline; \
print(output); \
sys.exit(0 if result.returncode == 0 or allowed else 1)"

RUN python -c "import importlib.metadata as m; assert m.version('pip')" && \
    python /opt/tributo/runtime-version-check.py

WORKDIR /workspace/tributo-src
