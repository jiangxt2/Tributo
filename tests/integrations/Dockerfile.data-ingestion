ARG BASE_IMAGE=rayproject/ray:2.55.1-py312

FROM ${BASE_IMAGE}

COPY --from=ghcr.io/astral-sh/uv:0.11.23 /uv /uvx /bin/

USER ray

ENV PATH="/opt/tributo/.venv/bin:${PATH}" \
    PYTHONUNBUFFERED=1 \
    UV_HTTP_RETRIES=10 \
    UV_HTTP_TIMEOUT=600 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/opt/tributo/.venv

COPY --chown=ray:users . /opt/tributo

WORKDIR /opt/tributo

RUN --mount=type=cache,target=/home/ray/.cache/uv,uid=1000,gid=100 \
    uv sync \
        --extra data-daft \
        --no-default-groups \
        --locked
