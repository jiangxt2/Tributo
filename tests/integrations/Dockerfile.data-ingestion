ARG BASE_IMAGE=rayproject/ray:2.55.1-py312@sha256:911245f2478ad2e9f67ac13978dc2a75bcae0498b9f188b10bba703324b78379

FROM ${BASE_IMAGE}

USER root
RUN python -m venv /opt/tributo/.venv && chown -R 1000:100 /opt/tributo

USER 1000:100

ENV PATH="/opt/tributo/.venv/bin:${PATH}" \
    PIP_DEFAULT_TIMEOUT=600 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

COPY --from=locked-requirements --chown=1000:100 /requirements.txt /opt/tributo/requirements.txt

WORKDIR /opt/tributo

RUN --mount=type=cache,target=/home/ray/.cache/pip,uid=1000,gid=100 \
    python -m pip install --require-hashes -r /opt/tributo/requirements.txt

RUN python -c "import importlib.metadata as m, sys; assert sys.version_info[:2] == (3, 12); assert m.version('pip'); assert m.version('ray') == '2.55.1'; assert m.version('daft').startswith('0.7.'); assert m.version('pylance') == '9.0.0'; assert m.version('lance-ray') == '0.5.0'; assert m.version('pyarrow') == '19.0.1'; assert m.version('daft-clickhouse') == '1.0'; assert m.version('daft-doris') == '1.0'; assert m.version('ray-doris') == '1.0'; assert m.version('ray-hive') == '1.0'; assert m.version('thrift') == '0.16.0'"

WORKDIR /workspace/tributo-src
