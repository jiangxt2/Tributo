ARG BASE_IMAGE=rayproject/ray:2.55.1-py312@sha256:911245f2478ad2e9f67ac13978dc2a75bcae0498b9f188b10bba703324b78379
ARG UV_IMAGE=ghcr.io/astral-sh/uv:0.11.23@sha256:d0a0a753ab981624b49c97abc98821c1c09f4ca69d1ef5cee69c501be3d88479

FROM ${UV_IMAGE} AS uv
FROM ${BASE_IMAGE}
COPY --from=uv /uv /uvx /bin/

USER root
RUN mkdir -p /opt/tributo && chown 1000:100 /opt/tributo

USER 1000:100

ENV PATH="/opt/tributo/.venv/bin:${PATH}" \
    PYTHONUNBUFFERED=1 \
    UV_HTTP_RETRIES=10 \
    UV_HTTP_TIMEOUT=600 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/opt/tributo/.venv

COPY --chown=1000:100 pyproject.toml uv.lock /opt/tributo/

WORKDIR /opt/tributo

RUN --mount=type=cache,target=/home/ray/.cache/uv,uid=1000,gid=100 \
    uv sync \
        --extra dev \
        --extra test-integration \
        --extra training \
        --extra registry \
        --extra model-export-torch \
        --extra model-export-hf \
        --extra data-daft \
        --extra vector-index \
        --no-default-groups \
        --no-install-project \
        --locked

# Ray 2.55.1 clones the active venv for runtime_env.pip. Bootstrap pip from
# Python's bundled ensurepip so offline Wheelhouse jobs never need an index.
RUN python -m ensurepip --upgrade

RUN python -c "import importlib.metadata as m, sys; assert sys.version_info[:2] == (3, 12); assert m.version('pip'); assert m.version('ray') == '2.55.1'; assert m.version('daft').startswith('0.7.'); assert m.version('pylance') == '9.0.0'; assert m.version('lance-ray') == '0.5.0'; assert m.version('pyarrow') == '19.0.1'"

WORKDIR /workspace/tributo-src
