{
  "algorithm": "multinomial_nb",
  "profile": "local",
  "worker_count": 2,
  "input": {
    "ingestion": {
      "source": {
        "type": "parquet",
        "path": "/absolute/path/to/training.parquet"
      },
      "engine": "ray"
    },
    "features": ["message_count", "call_duration"],
    "label": "label"
  },
  "algorithm_config": {
    "alpha": 1.0,
    "output": {
      "bundle_uri": "/absolute/path/to/bundles/multinomial-nb"
    }
  }
}
